<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="smartnote"
        Arguments=""
        InstallLocation="C:\Program Files\Nikita Chisnikov\Smartnote">
    </Installer>
    <PackageInformation
        PackageName="Smartnote"
        PackageDisplayName="Smartnote"
        PublisherName="CN=Nikita Chisnikov"
        PublisherDisplayName="Nikita Chisnikov"
        Version="2.0.0.0"
        PackageDescription="A notepad for private records">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.nikchis.smartnote"
                Description="A notepad for private records"
                DisplayName="Smartnote"
                ExecutableName="smartnote"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Smartnote</DisplayName>
            <PublisherDisplayName>Nikita Chisnikov</PublisherDisplayName>
            <Description>A notepad for private records</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="smartnote.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
